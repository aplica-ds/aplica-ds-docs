---
interface Props {
  lang?: string;
}
const { lang = 'pt-BR' } = Astro.props;
const isPt = lang.toLowerCase().startsWith('pt');

const t = isPt
  ? {
      title:       'Este site usa cookies',
      description: 'Usamos o Google Analytics para entender como o site é usado e melhorar a experiência. Cookies funcionais (tema, idioma) são sempre ativos.',
      accept:      'Aceitar analytics',
      reject:      'Rejeitar',
      privacy:     'Política de Privacidade',
      privacyHref: '/privacy',
    }
  : {
      title:       'This site uses cookies',
      description: 'We use Google Analytics to understand how the site is used and improve the experience. Functional cookies (theme, language) are always active.',
      accept:      'Accept analytics',
      reject:      'Reject',
      privacy:     'Privacy Policy',
      privacyHref: '/en/privacy',
    };
---

<div
  id="aplica-cookie-banner"
  role="dialog"
  aria-modal="false"
  aria-label={isPt ? 'Aviso de cookies' : 'Cookie notice'}
  class="cookie-banner"
  style="display: none;"
>
  <div class="cookie-content">
    <p class="cookie-title">{t.title}</p>
    <p class="cookie-desc">
      {t.description}
      <a href={t.privacyHref} class="cookie-link">{t.privacy}</a>.
    </p>
  </div>
  <div class="cookie-actions">
    <button id="aplica-consent-reject" class="cookie-btn-reject">{t.reject}</button>
    <button id="aplica-consent-accept" class="cookie-btn-accept">{t.accept}</button>
  </div>
</div>

<style>
  /* ── Desktop: floating card anchored to bottom-left ── */
  .cookie-banner {
    position: fixed;
    bottom: 1.5rem;
    left: 1.5rem;
    z-index: 9998;
    width: 380px;
    border-radius: 1rem;
    border: 1px solid #374151;
    padding: 1.25rem 1.5rem 1.25rem;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.45);
    flex-direction: column;
    gap: 1rem;
    background: #111827;
  }

  :global(html.dark) .cookie-banner {
    background: #ffffff;
    border-color: #e5e7eb;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.15);
  }

  .cookie-content {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .cookie-title {
    font-weight: 600;
    font-size: 0.9375rem;
    margin: 0;
    color: #f9fafb;
  }

  :global(html.dark) .cookie-title {
    color: #111827;
  }

  .cookie-desc {
    font-size: 0.8125rem;
    line-height: 1.55;
    margin: 0;
    color: #9ca3af;
  }

  :global(html.dark) .cookie-desc {
    color: #6b7280;
  }

  .cookie-link {
    color: #f97316;
    text-decoration: underline;
    margin-left: 0.25rem;
  }

  .cookie-actions {
    display: flex;
    gap: 0.625rem;
  }

  .cookie-btn-reject {
    flex: 1;
    padding: 0.5rem 1rem;
    border: 1px solid #4b5563;
    background: transparent;
    color: #9ca3af;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    cursor: pointer;
    font-family: inherit;
    transition: border-color 0.15s, color 0.15s;
  }

  .cookie-btn-reject:hover {
    border-color: #9ca3af;
    color: #f9fafb;
  }

  :global(html.dark) .cookie-btn-reject {
    border-color: #d1d5db;
    color: #6b7280;
  }

  :global(html.dark) .cookie-btn-reject:hover {
    border-color: #6b7280;
    color: #111827;
  }

  .cookie-btn-accept {
    flex: 2;
    padding: 0.5rem 1rem;
    background: #f97316;
    color: #ffffff;
    border: none;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    transition: opacity 0.15s;
  }

  .cookie-btn-accept:hover {
    opacity: 0.88;
  }

  /* ── Mobile: full-width bar at bottom ── */
  @media (max-width: 600px) {
    .cookie-banner {
      bottom: 0;
      left: 0;
      right: 0;
      width: auto;
      border-radius: 0;
      border-left: none;
      border-right: none;
      border-bottom: none;
      padding: 1rem 1rem 1.25rem;
      box-shadow: 0 -4px 32px rgba(0, 0, 0, 0.3);
    }

    :global(html.dark) .cookie-banner {
      box-shadow: 0 -4px 32px rgba(0, 0, 0, 0.12);
    }
  }
</style>

<script is:inline>
  (function () {
    var banner = document.getElementById('aplica-cookie-banner');
    var kofi = document.getElementById('kofi-float');
    if (!banner) return;

    function getBannerHeight() {
      return banner.offsetHeight || 0;
    }

    function isMobile() {
      return window.innerWidth <= 600;
    }

    function pushKofi() {
      if (!kofi || !isMobile()) return;
      kofi.style.bottom = (getBannerHeight() + 16) + 'px';
    }

    function resetKofi() {
      if (!kofi) return;
      kofi.style.bottom = '1.5rem';
    }

    function showBanner() {
      banner.style.display = 'flex';
      // Wait one frame so offsetHeight is computed after display:flex
      requestAnimationFrame(pushKofi);
    }

    function hideBanner() {
      banner.style.display = 'none';
      resetKofi();
    }

    function saveConsent(analytics) {
      try {
        localStorage.setItem('aplica-consent', JSON.stringify({ analytics: analytics, ts: new Date().toISOString(), v: '1' }));
      } catch (e) {}
    }

    function loadGA() {
      if (window.__aplica_ga_loaded) return;
      window.__aplica_ga_loaded = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-VVFNS1CWQK';
      document.head.appendChild(s);
      s.onload = function () {
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', 'G-VVFNS1CWQK', { anonymize_ip: true });
      };
    }

    document.getElementById('aplica-consent-accept').addEventListener('click', function () {
      saveConsent(true);
      loadGA();
      hideBanner();
    });

    document.getElementById('aplica-consent-reject').addEventListener('click', function () {
      saveConsent(false);
      hideBanner();
    });

    // Show banner only if no stored consent
    try {
      var stored = JSON.parse(localStorage.getItem('aplica-consent') || 'null');
      if (!stored) {
        showBanner();
      } else if (stored.analytics === true) {
        loadGA();
      }
    } catch (e) {
      showBanner();
    }
  })();
</script>
